# Copy to .env. Only the keys for the providers you use are needed; local servers need none.

# System One decision models (systemone:jev-latest) and OpenRouter chat models (openrouter:openai/gpt-5-mini).
OPENROUTER_API_KEY=
# OpenAI chat models (openai:gpt-5-mini).
# OPENAI_API_KEY=

# Local servers, if not at their usual address (ollama:llama3.1:8b, lmstudio:qwen2.5-7b-instruct).
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# The models to play when a command names none: `npm run versus` plays the first two, `npm run bench` the first.
# MODELS=systemone:jev-latest,ollama:llama3.1:8b

# A bearer token for --endpoint runs, if your endpoint needs one.
# BENCH_ENDPOINT_TOKEN=
# Tokens for the endpoints in players.json, by the names their "tokenEnv" gives.
# MY_MODEL_TOKEN=
